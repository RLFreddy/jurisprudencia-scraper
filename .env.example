# ============================================================
# Scraper Jurisprudencia PJ — configuration
# Copy this file to .env (cp .env.example .env) and run: pnpm dev
# Every variable explains what it does and when to touch it.
# ============================================================

# ------------------------------------------------------------
# Run scope
# ------------------------------------------------------------

# How many pages to process in this run.
#   0  → all pages (the site reports the total at start, ~21,000)
#   N  → only N pages, continuing from where the last run left off
PAGES=0

# Download the PDFs in addition to the metadata?
#   1  → metadata.csv + ZIP + extracted PDFs (the ZIP is deleted)
#   0  → metadata.csv only (faster, less pressure on the site)
DOWNLOAD_PDFS=1

# ------------------------------------------------------------
# Retries and timing (anti rate-limit)
# ------------------------------------------------------------

# Retries per request on 429/5xx/network failures.
# Exponential backoff: 1s, 2s, 4s, 8s → RETRY_BASE_DELAY_MS × 2^(attempt-1)
RETRIES=4
RETRY_BASE_DELAY_MS=1000

# ZIP POST retries (less pressure on the WAF).
ZIP_RETRIES=2

# Pause between pages. Raise it if you see many failures; lower it if smooth.
REQUEST_DELAY_MS=2500

# Cooldown before opening a new session (the WAF blocks if hit too often).
# Raise it if "decoy" sessions appear (200 with 0 results).
RATE_LIMIT_COOLDOWN_MS=60000

# Max times a real session is attempted before giving up.
MAX_COOLDOWN_CYCLES=3

# Attempts per page before abandoning it (it's skipped and the next continues).
MAX_ATTEMPTS=5

# Consecutive ZIP failures that trigger a session renewal.
ZIP_FAILURES_BEFORE_RENEW=2

# Proactive rotation: renew the session every N pages (the WAF evicts ~11 ZIPs).
PAGES_PER_SESSION=8

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------

# SQLite database with each page's state (resume). Don't touch by hand.
DB_PATH=scraper.db

# Output folder: files/page-N/{metadata.csv, *.pdf}
OUTPUT_DIR=files

# ZIP POST timeout (milliseconds).
ZIP_TIMEOUT_MS=45000

# Errors: one JSON line per event + dump of failed bodies organized by day.
ERROR_LOG_PATH=errors/events.jsonl
ERROR_DIR=errors/dumps

# ------------------------------------------------------------
# Identity
# ------------------------------------------------------------

# User-Agent used to request the portal.
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36 Edg/149.0.0.0

# ------------------------------------------------------------
# Examples
# ------------------------------------------------------------
#   pnpm dev                           → all pages (~21,000) with PDFs
#   DOWNLOAD_PDFS=0 pnpm dev           → metadata only for all pages
#   DOWNLOAD_PDFS=0 PAGES=100 pnpm dev → metadata for 100 pages (fast)
#   PAGES=5 pnpm dev                   → 5 pages with PDFs
#   PAGES=5 DOWNLOAD_PDFS=0 pnpm dev   → 5 pages, metadata only